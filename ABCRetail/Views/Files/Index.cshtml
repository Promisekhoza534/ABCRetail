@model List<string>

@{
    ViewData["Title"] = "Application Logs";
}

<h2>Application Logs</h2>

<form asp-action="Upload"
      method="post"
      enctype="multipart/form-data"
      class="mb-4">

    <div class="mb-3">
        <label class="form-label">Upload Log File</label>

        <input type="file"
               name="file"
               class="form-control"
               required />
    </div>

    <button type="submit" class="btn btn-primary">
        Upload File
    </button>

</form>

<h4>Stored Log Files</h4>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>#</th>
            <th>File Name</th>
        </tr>
    </thead>

    <tbody>

        @if (Model != null && Model.Count > 0)
        {
            int number = 1;

            foreach (var file in Model)
            {
                <tr>
                    <td>@number</td>
                    <td>@file</td>
                </tr>

                number++;
            }
        }
        else
        {
            <tr>
                <td colspan="2">
                    No log files available.
                </td>
            </tr>
        }

    </tbody>

</table>